#!/usr/bin/env bash
# Launch Claude Code against the local MultiAI Router.
# Sets the gateway env and makes localhost bypass any system proxy, so no manual
# NO_PROXY / ANTHROPIC_* setup is needed (works in Termux, Linux, macOS, Git Bash).
#
# Usage: bin/claude-router [claude args...]
# Override: ROUTER_URL, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_MODEL

export ANTHROPIC_BASE_URL="${ROUTER_URL:-http://localhost:8788}"
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-any-key}"
unset ANTHROPIC_API_KEY

# Keep any existing NO_PROXY entries and add localhost.
export NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"
export no_proxy="$NO_PROXY"

exec claude "$@"
