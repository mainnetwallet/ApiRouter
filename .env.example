# ============================================================
# MultiAI Router - Environment Configuration
# ============================================================

PORT=8788
REQUEST_TIMEOUT_MS=120000
# Streaming requests: max wait for the provider to start responding before falling back.
STREAM_CONNECT_TIMEOUT_MS=30000
# Max client request size in MB (Claude Code resends the whole conversation, images included).
MAX_REQUEST_BODY_MB=32

# Optional client authentication. Leave empty for local trusted use.
MULTIAI_ROUTER_API_KEYS=

# ============================================================
# 1. API KEYS - ALL PROVIDERS
# ============================================================

AGENTROUTER_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=
HUGGINGFACE_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
CLOUDFLARE_API_KEYS=
# Cloudflare Account IDs, in the SAME ORDER as the keys above: key 1 uses id 1, key 2 uses id 2.
# One id for several keys means they all belong to that account. The base URL is built from it.
CLOUDFLARE_ACCOUNT_IDS=
SAMBANOVA_API_KEYS=
COHERE_API_KEYS=
ZAI_API_KEYS=
VERCEL_API_KEYS=
NVIDIA_API_KEYS=
OPENCODE_API_KEYS=
NOUS_API_KEYS=
POLLINATIONS_API_KEYS=
SILICONFLOW_API_KEYS=
MODELSCOPE_API_KEYS=
LLM7_API_KEYS=

# ============================================================
# 2. MODELS
# ============================================================

AGENTROUTER_MODELS=claude-opus-5,claude-opus-4-8,gpt-6-astra,deepseek-v4-flash
VERCEL_MODELS=minimax/minimax-m3-free,inclusionai/ling-3.1-flash-free,inclusionai/ling-3.0-flash-vl-free,inclusionai/ling-3.0-flash-sante-free,inclusionai/ling-3.0-flash-fin-free,poolside/laguna-s-2.1-free
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
HUGGINGFACE_MODELS=Qwen/Qwen3-Coder-480B-A35B-Instruct,openai/gpt-oss-120b,zai-org/GLM-4.5,Qwen/Qwen2.5-Coder-32B-Instruct,deepseek-ai/DeepSeek-R1,Qwen/Qwen3-4B-Thinking-2507
MISTRAL_MODELS=mistral-small-latest
OPENROUTER_MODELS=nvidia/nemotron-3-ultra:free,poolside/laguna-s-2.1:free,cohere/north-mini-code:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,thinkingmachines/inkling:free,dots-studio/dots3-note:free,poolside/laguna-xs-2.1:free,thinkingmachines/inkling-small:free
CEREBRAS_MODELS=glm-4.7
CLOUDFLARE_MODELS=@cf/zai-org/glm-5.3,@cf/deepseek-ai/deepseek-v4-pro-0813,@cf/moonshotai/kimi-k2.7-code,@cf/zai-org/glm-5.3-flash,@cf/deepseek-ai/deepseek-v4-flash-0731,@cf/zai-org/glm-5.2,@cf/moonshotai/kimi-k2.6,@cf/qwen/qwen3.8-27b,@cf/openai/gpt-oss-120b,@cf/nvidia/nemotron-3-120b-a12b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/google/gemma-4-26b-a4b-it,@cf/openai/gpt-oss-20b,@cf/zai-org/glm-4.7-flash,@cf/qwen/qwq-32b
SAMBANOVA_MODELS=DeepSeek-V3.2,MiniMax-M3,gpt-oss-120b
COHERE_MODELS=command-a-plus-05-2026,command-a-03-2025,command-a-reasoning-08-2025,north-mini-code-1-0,command-a-translate-08-2025,command-r7b-12-2024,command-r-plus-08-2024,command-r-08-2024
ZAI_MODELS=glm-5.3,glm-5.3-flash,glm-5.2,glm-5-turbo
NVIDIA_MODELS=deepseek-v4.1-flash,glm-5-3-flash,glm-5-3,nemotron-3-super-120b-a12b,nemotron-3.5-lightning-30b-a3b
OPENCODE_MODELS=mimo-v2.6-flash-free,longcat-2.5-preview-free,nemotron-3-ultra-free,nemotron-3.5-lightning-free,big-pickle,muse-spark-1.3-contributor-free,ling-3.1-flash-free,ling-3.0-flash-fin-free,space-bunny-free,fledge-alpha-free,jev-1.13-free
NOUS_MODELS=poolside/laguna-s-2.1:free,stepfun/step-3.7-flash:free,meituan/longcat-2.5-preview:free,inclusionai/ling-3.0-flash-fin:free,meituan/longcat-2.0:free,poolside/laguna-xs-2.1:free,inclusionai/ling-3.0-flash-sante:free,upstage/solar-pro4:free
POLLINATIONS_MODELS=kimi,deepseek,deepseek-pro,glm,gemini-search,claude-fast,openclaw,community/scriptsnsenses-sys/muse-spark-1.2-contributor-free,community/scriptsnsenses-sys/glm-5.3-flash-free

# SiliconFlow free models: keep the free/coding-capable models first.
SILICONFLOW_MODELS=Qwen/Qwen3.5-4B,XingChenAGI/Xing4.0-29B,THUDM/GLM-4-9B-0414,tencent/Hunyuan-MT-7B
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ModelScope free API-Inference pool (quota-based: 2,000 calls/day, 500/model/day).
MODELSCOPE_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,Qwen/Qwen3.8-Flash-Next,stepfun-ai/Step-3.7-Flash,ZhipuAI/GLM-5.3,ZhipuAI/GLM-5.3-Flash,Qwen/Qwen3.8-27B,moonshotai/Kimi-K3,deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# LLM7 free-token quota pool (quota-based; availability and limits can change).
LLM7_MODELS=DeepSeek-V4-Flash-0731,GLM-5.3-Flash,minimax-m2.7,DeepSeek-V4.1-Flash
LLM7_BASE_URL=https://api.llm7.io/v1

# ============================================================
# 3. BASE URL - ALL PROVIDERS
# ============================================================

AGENTROUTER_BASE_URL=https://agentrouter.org

# AgentRouter Codex-compatible client identity.
AGENTROUTER_ORIGINATOR=codex_cli_rs
AGENTROUTER_VERSION=
AGENTROUTER_USER_AGENT=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GROQ_BASE_URL=https://api.groq.com/openai/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
COHERE_BASE_URL=https://api.cohere.com/compatibility/v1
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1

# ============================================================
# 4. VISION PROVIDERS (image requests only)
# ============================================================
# A separate pool just for requests that carry an image. Every provider has its
# own key, its own base URL and its own models (<PROVIDER>_VISION_*), nothing is
# shared with the text pool above.
#   - A request with an image is routed ONLY to these vision targets.
#   - A text request never uses them.
#   - A vision provider is active once it has keys, models AND a base URL.
#   - Multiple keys / models: comma-separated.
#
# IMPORTANT: If no fully configured vision provider exists, image requests fail
# with HTTP 503 and error type no_vision_route; they never fall back to the
# normal text pool (this applies to every provider).

VERCEL_VISION_API_KEYS=
VERCEL_VISION_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_VISION_MODELS=minimax/minimax-m3-free,inclusionai/ling-3.0-flash-vl-free

AGENTROUTER_VISION_API_KEYS=
AGENTROUTER_VISION_BASE_URL=https://agentrouter.org
AGENTROUTER_VISION_MODELS=

GEMINI_VISION_API_KEYS=
GEMINI_VISION_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_VISION_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

GROQ_VISION_API_KEYS=
GROQ_VISION_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODELS=qwen/qwen3.8-27b

HUGGINGFACE_VISION_API_KEYS=
HUGGINGFACE_VISION_BASE_URL=https://router.huggingface.co/
HUGGINGFACE_VISION_MODELS=

MISTRAL_VISION_API_KEYS=
MISTRAL_VISION_BASE_URL=https://api.mistral.ai/v1
MISTRAL_VISION_MODELS=ministral-14b-2512,ministral-8b-2512,ministral-3b-2512,mistral-small-2506,mistral-medium-2508,mistral-large-2512

OPENROUTER_VISION_API_KEYS=
OPENROUTER_VISION_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODELS=qwen/qwen3.8-27b:free,thinkingmachines/inkling:free,thinkingmachines/inkling-small:free,nvidia/nemotron-3-nano-omni:free,dots-studio/dots3-note:free

CEREBRAS_VISION_API_KEYS=
CLOUDFLARE_VISION_API_KEYS=
# Same rule as the text pool: one account id per key, in the same order.
CLOUDFLARE_VISION_ACCOUNT_IDS=
CLOUDFLARE_VISION_MODELS=@cf/zai-org/glm-5.3-flash,@cf/qwen/qwen3.8-27b,@cf/moonshotai/kimi-k2.7-code,@cf/moonshotai/kimi-k2.6,@cf/google/gemma-4-26b-a4b-it,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/meta/llama-3.2-11b-vision-instruct,@cf/cloudflare/clef,@cf/cloudflare/clef-flash,@cf/moondream/moondream3.1-9B-A2B

SAMBANOVA_VISION_API_KEYS=
SAMBANOVA_VISION_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_VISION_MODELS=MiniMax-M3,gemma-4-31B-it

COHERE_VISION_API_KEYS=
COHERE_VISION_BASE_URL=https://api.cohere.com/v1
COHERE_VISION_MODELS=command-a-plus-05-2026,command-a-vision-07-2025,c4ai-aya-vision-32b

ZAI_VISION_API_KEYS=
ZAI_VISION_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_VISION_MODELS=glm-5.3-flash,glm-5v-turbo

NVIDIA_VISION_API_KEYS=
NVIDIA_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODELS=deepseek-v4.1-flash,glm-5-3-flash,muse-glimmer-30b,llama-3.2-90b-vision-instruct,llama-3.2-11b-vision-instruct

OPENCODE_VISION_API_KEYS=
OPENCODE_VISION_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_VISION_MODELS=mimo-v2.6-flash-free,longcat-2.5-preview-free

NOUS_VISION_API_KEYS=
NOUS_VISION_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_VISION_MODELS=stepfun/step-3.7-flash:free

POLLINATIONS_VISION_API_KEYS=
POLLINATIONS_VISION_BASE_URL=https://gen.pollinations.ai/v1
POLLINATIONS_VISION_MODELS=kimi,gemini-search,claude-fast

# SiliconFlow vision pool. Only populate with models verified to accept image input
# and marked free by the current SiliconFlow catalog.
SILICONFLOW_VISION_API_KEYS=
SILICONFLOW_VISION_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_VISION_MODELS=Qwen/Qwen3.5-4B,PaddlePaddle/PaddleOCR-VL-1.5

# ModelScope vision pool. Keep multimodal models here only.
MODELSCOPE_VISION_API_KEYS=
MODELSCOPE_VISION_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_VISION_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,Qwen/Qwen3.8-Flash-Next,stepfun-ai/Step-3.7-Flash,ZhipuAI/GLM-5.3-Flash,Qwen/Qwen3.8-27B,moonshotai/Kimi-K3,deepseek-ai/DeepSeek-V4-Flash-Vision-Exp

# LLM7 vision pool. Uses the same free-token quota; models are not $0-priced.
LLM7_VISION_API_KEYS=
LLM7_VISION_BASE_URL=https://api.llm7.io/v1
LLM7_VISION_MODELS=kimi-k3,llama-4-maverick,minimax-m3


# ============================================================
# 5. RETRY POLICY
# ============================================================

RETRY_STATUS_CODES=401,402,403,404,408,409,425,429,500,501,502,503,504,520,521,522,523,524,529

# ============================================================
# Notes:
# - Multiple API keys: comma-separated
# - Multiple models: comma-separated
# - Keep real secrets in local .env only
# - Free access is quota/plan dependent and can change.
# - Verify provider model availability before production use.
# ============================================================
