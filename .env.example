# ============================================================
# ApiRouter - Environment Configuration
# ============================================================


PORT=8788
REQUEST_TIMEOUT_MS=120000
# Streaming requests: max wait for the provider to start responding before falling back.
STREAM_CONNECT_TIMEOUT_MS=30000


# Optional client authentication. Leave empty for local trusted use.
APIROUTER_API_KEYS=



# ============================================================
# 5. RETRY POLICY
# ============================================================

RETRY_STATUS_CODES=401,402,403,404,408,409,425,429,500,501,502,503,504,520,521,522,523,524,529




# ============================================================
# FALLBACK CHAIN (optional)
# ============================================================
# Routing order is configuration, not environment: it lives in the Fallback
# Chain, which the control panel owns (Configure -> Fallback Chain).
# This only says WHERE that chain is persisted.

FALLBACK_CHAIN_FILE=data/fallback-chain.json

# Legacy, read ONCE on first start to seed the chain above, then ignored
# forever. The old priority variables (TEXT_PRIORITY_MODELS /
# VISION_PRIORITY_MODELS) are no longer read at all: the chain is the single
# source of truth for both pools.
MANUAL_SELECTION_FILE=data/manual-selection.json


# ============================================================
# 1. API KEYS - ALL PROVIDERS
# ============================================================

AGENTROUTER_API_KEYS=

GEMINI_API_KEYS=

GROQ_API_KEYS=

HUGGINGFACE_API_KEYS=

MISTRAL_API_KEYS=

OPENROUTER_API_KEYS=

CEREBRAS_API_KEYS=

CLOUDFLARE_API_KEYS=

CLOUDFLARE_ACCOUNT_IDS=

SAMBANOVA_API_KEYS=

COHERE_API_KEYS=

ZAI_API_KEYS=

VERCEL_API_KEYS=

NVIDIA_API_KEYS=

OPENCODE_API_KEYS=

NOUS_API_KEYS=

POLLINATIONS_API_KEYS=

SILICONFLOW_API_KEYS=

MODELSCOPE_API_KEYS=

LLM7_API_KEYS=




# ============================================================
# 2. MODELS
# ============================================================

AGENTROUTER_MODELS=claude-opus-5,claude-opus-4-8,gpt-6-astra,deepseek-v4-flash
VERCEL_MODELS=poolside/laguna-s-2.1-free,inclusionai/ling-3.1-flash-free
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
HUGGINGFACE_MODELS=Qwen/Qwen3-Coder-480B-A35B-Instruct,openai/gpt-oss-120b,deepseek-ai/DeepSeek-V4-Pro,zai-org/GLM-5.3,deepseek-ai/DeepSeek-V4.1-Flash,Qwen/Qwen3.8-27B
MISTRAL_MODELS=devstral-medium-latest,mistral-medium-3-5
OPENROUTER_MODELS=poolside/laguna-s-2.1:free,cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free
CEREBRAS_MODELS=qwen-3.8-27b,gpt-oss-120b
CLOUDFLARE_MODELS=@cf/qwen/qwen3.8-27b,@cf/openai/gpt-oss-120b,@cf/nvidia/nemotron-3-120b-a12b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/google/gemma-4-26b-a4b-it,@cf/zai-org/glm-4.7-flash
SAMBANOVA_MODELS=
COHERE_MODELS=command-a-plus-05-2026,north-mini-code-1-0,command-a-03-2025,command-a-reasoning-08-2025
ZAI_MODELS=glm-4.7-flash
NVIDIA_MODELS=deepseek-v4.1-flash,glm-5-3-flash,glm-5-3,nemotron-3-super-120b-a12b,nemotron-3.5-lightning-30b-a3b
OPENCODE_MODELS=space-bunny-free
NOUS_MODELS=poolside/laguna-s-2.1:free,stepfun/step-3.7-flash:free,meituan/longcat-2.5-preview:free,meituan/longcat-2.0:free,poolside/laguna-xs-2.1:free,upstage/solar-pro4:free
POLLINATIONS_MODELS=kimi,deepseek-pro,glm,claude-fast
SILICONFLOW_MODELS=
MODELSCOPE_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,Qwen/Qwen3.8-Flash-Next,stepfun-ai/Step-3.7-Flash,ZhipuAI/GLM-5.3,ZhipuAI/GLM-5.3-Flash,Qwen/Qwen3.8-27B,moonshotai/Kimi-K3
LLM7_MODELS=DeepSeek-V4-Flash-0731,GLM-5.3-Flash,minimax-m2.7





# ============================================================
# 3. BASE URL - ALL PROVIDERS
# ============================================================
#
# An API root only. Add no query string and no fragment: the router appends
# the endpoint path to this value as a plain string, so a `?` here would put
# the path inside the query. A base URL containing `?` or `#` is refused at
# startup. Both forms below are accepted, with or without a trailing slash:
#
#   https://generativelanguage.googleapis.com          -> .../v1beta/models/...
#   https://generativelanguage.googleapis.com/v1beta   -> .../v1beta/models/...
#   https://api.groq.com/openai/v1                     -> .../v1/chat/completions
#   https://proxy.internal/custom/v2                   -> .../custom/v2/chat/completions
#
# A version already on the base URL is never duplicated. For OpenAI-compatible
# providers any trailing version is respected as the API root, so a custom
# `/v2` or `/openai/v1` path keeps working.

AGENTROUTER_BASE_URL=https://agentrouter.org

# AgentRouter Codex-compatible client identity.
AGENTROUTER_ORIGINATOR=codex_cli_rs
AGENTROUTER_VERSION=
AGENTROUTER_USER_AGENT=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GROQ_BASE_URL=https://api.groq.com/openai/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
COHERE_BASE_URL=https://api.cohere.com/compatibility/v1
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
LLM7_BASE_URL=https://api.llm7.io/v1






