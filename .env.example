# ============================================================
# MultiAI Router - Environment Configuration
# ============================================================

PORT=8788
REQUEST_TIMEOUT_MS=120000
# Streaming requests: max wait for the provider to start responding before falling back.
STREAM_CONNECT_TIMEOUT_MS=30000

# Optional client authentication. Leave empty for local trusted use.
MULTIAI_ROUTER_API_KEYS=

# ============================================================
# 1. API KEYS - ALL PROVIDERS
# ============================================================

AGENTROUTER_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=
HUGGINGFACE_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
CLOUDFLARE_API_KEYS=
SAMBANOVA_API_KEYS=
COHERE_API_KEYS=
ZAI_API_KEYS=

# ============================================================
# 2. MODELS
# ============================================================

AGENTROUTER_MODELS=claude-opus-5,claude-opus-4-8,gpt-6-astra,deepseek-v4-flash
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
HUGGINGFACE_MODELS=Qwen/Qwen3-Coder-480B-A35B-Instruct,zai-org/GLM-4.5,openai/gpt-oss-120b,Qwen/Qwen2.5-Coder-32B-Instruct,deepseek-ai/DeepSeek-V3.1,moonshotai/Kimi-K2-Instruct
MISTRAL_MODELS=mistral-small-latest
OPENROUTER_MODELS=nvidia/nemotron-3-ultra:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3:free,cohere/north-mini-code:free
CEREBRAS_MODELS=qwen-3-235b-a22b-instruct-2507,gpt-oss-120b,glm-4.7
CLOUDFLARE_MODELS=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b,@cf/zai-org/glm-4.7-flash,@cf/google/gemma-4-26b-a4b-it,@cf/nvidia/nemotron-3-120b,@cf/qwen/qwen3.8-27b,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/mistral/mistral-small-3.1-24b-instruct
SAMBANOVA_MODELS=
COHERE_MODELS=command-a-reasoning-08-2025,command-a-plus-05-2026
ZAI_MODELS=glm-4.7-flash,glm-4.5-flash

# ============================================================
# 3. BASE URL - ALL PROVIDERS
# ============================================================

AGENTROUTER_BASE_URL=https://agentrouter.org

# AgentRouter Codex-compatible client identity.
AGENTROUTER_ORIGINATOR=codex_cli_rs
AGENTROUTER_VERSION=
AGENTROUTER_USER_AGENT=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GROQ_BASE_URL=https://api.groq.com/openai/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CLOUDFLARE_BASE_URL=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
COHERE_BASE_URL=https://api.cohere.com/compatibility/v1
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ============================================================
# 4. RETRY POLICY
# ============================================================

RETRY_STATUS_CODES=401,402,403,404,408,409,425,429,500,501,502,503,504,520,521,522,523,524,529

# ============================================================
# Notes:
# - Multiple API keys: comma-separated
# - Multiple models: comma-separated
# - Keep real secrets in local .env only
# - Free access is quota/plan dependent and can change.
# - Verify provider model availability before production use.
# ============================================================
