# ============================================================
# MultiAI Router - Environment Configuration
# ============================================================

PORT=8788
REQUEST_TIMEOUT_MS=120000

# Optional client authentication. Leave empty for local trusted use.
MULTIAI_ROUTER_API_KEYS=

# ============================================================
# 1. API KEYS - ALL PROVIDERS
# ============================================================

AGENTROUTER_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=
HUGGINGFACE_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
CLOUDFLARE_API_KEYS=
SAMBANOVA_API_KEYS=
COHERE_API_KEYS=
ZAI_API_KEYS=

# ============================================================
# 2. MODELS
#
# The entries below are only models with documented free/free-tier
# access or $0 endpoint pricing verified against provider docs.
# Free access is still subject to each provider's account, region,
# quota and rate limits. A model being open-weight does NOT mean
# its hosted API is free.
# ============================================================

# AgentRouter: no model is listed until the current model catalog
# and account-level free access are independently verified.
AGENTROUTER_MODELS=

# Gemini: these models currently document a Free Tier.
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Groq: these models are available on Groq's Free Plan limits.
# Their developer-tier token pricing is non-zero, so do not treat
# them as universally $0-priced APIs.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Hugging Face Inference Providers currently provide limited free
# monthly credits rather than universally-free model endpoints.
# Keep empty here to avoid silently consuming paid usage.
HUGGINGFACE_MODELS=

# Mistral provides a no-card Free mode. Use the documented
# free-mode quickstart model rather than assuming every model is free.
MISTRAL_MODELS=mistral-small-latest

# OpenRouter: these are explicit :free endpoints. The free pool
# can change over time, so this list should be periodically rechecked.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3:free,cohere/north-mini-code:free

# Cerebras currently advertises free trial/limited access rather than
# a permanently $0 model price. Keep empty for strict no-charge routing.
CEREBRAS_MODELS=

# Cloudflare Workers AI models are usage-priced. Account allocation
# does not make the model universally free, so keep this empty for
# strict no-charge routing.
CLOUDFLARE_MODELS=

# SambaNova free-model availability was not sufficiently verified
# from current first-party model/pricing documentation. Keep empty
# until a current provider-side verification is available.
SAMBANOVA_MODELS=

# Cohere explicitly documents Command A Reasoning and Command A+
# as free until their applicable rate limits are reached.
COHERE_MODELS=command-a-reasoning-08-2025,command-a-plus-05-2026

# Z.AI model/free-tier status was not sufficiently verified from
# current first-party documentation. Keep empty until verified.
ZAI_MODELS=

# ============================================================
# 3. BASE URL - ALL PROVIDERS
# ============================================================

AGENTROUTER_BASE_URL=https://agentrouter.org/
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GROQ_BASE_URL=https://api.groq.com/openai/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CLOUDFLARE_BASE_URL=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
COHERE_BASE_URL=https://api.cohere.com/compatibility/v1
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ============================================================
# 4. RETRY POLICY
# ============================================================

# HTTP status codes that trigger retry/fallback.
# Add or remove codes manually, comma-separated.
RETRY_STATUS_CODES=402,408,429,500,502,503,504

# ============================================================
# Notes:
# - Multiple API keys: comma-separated
# - Multiple models: comma-separated
# - Keep real secrets in local .env only
# - Free access is quota/plan dependent and can change.
# - Verify provider model availability before production use.
# ============================================================
