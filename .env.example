# ============================================================
# ApiRouter - Environment Configuration
# ============================================================


PORT=8788
REQUEST_TIMEOUT_MS=120000
# Streaming requests: max wait for the provider to start responding before falling back.
STREAM_CONNECT_TIMEOUT_MS=30000


# Optional client authentication. Leave empty for local trusted use.
APIROUTER_API_KEYS=



# ============================================================
# 5. RETRY POLICY
# ============================================================

RETRY_STATUS_CODES=401,402,403,404,408,409,425,429,500,501,502,503,504,520,521,522,523,524,529




# ============================================================
# PRIORITY ROUTING (optional)
# ============================================================

VISION_PRIORITY_MODELS=modelscope/moonshotai/Kimi-K3,gemini/gemini-3.8-flash,gemini/gemini-3.7-flash,gemini/gemini-3.6-flash,gemini/gemini-3.5-flash,zai/glm-5v-turbo,sambanova/MiniMax-M3,modelscope/Qwen/Qwen3.8-Flash-Next,cohere/command-a-plus-05-2026,mistral/mistral-large-2512,modelscope/deepseek-ai/DeepSeek-V4.1-Flash,cloudflare/@cf/qwen/qwen3.8-27b,modelscope/Qwen/Qwen3.8-27B,modelscope/stepfun-ai/Step-3.7-Flash,nous/stepfun/step-3.7-flash:free,groq/qwen/qwen3.8-27b,openrouter/qwen/qwen3.8-27b:free,zai/glm-5.3-flash,modelscope/ZhipuAI/GLM-5.3-Flash,nvidia/deepseek-v4.1-flash,nvidia/glm-5-3-flash,vercel/minimax/minimax-m3-free,mistral/mistral-medium-2508,openrouter/thinkingmachines/inkling:free,pollinations/kimi
