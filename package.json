{
  "name": "multi-ai-router",
  "version": "0.1.0",
  "private": true,
  "description": "Protocol-aware multi-provider AI router with health tracking and automatic fallback.",
  "type": "module",
  "scripts": {
    "start": "npm run ui:build && node src/server.js",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/server.js",
    "ui:dev": "vite --config ui/vite.config.js",
    "ui:build": "vite build --config ui/vite.config.js",
    "ui:preview": "vite preview --config ui/vite.config.js",
    "demo:live-logs": "node scripts/demo-live-logs.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
